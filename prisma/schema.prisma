// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model - supports superadmin, admin, agent, and agency users
model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  password        String?
  role            String        @default("agency") // "superadmin" | "admin" | "agent" | "agency"
  agencyId        String?
  agency          Agency?       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  sessions        Session[]
  loginLogs       LoginLog[]
  assignedLeads   Lead[]        @relation("AssignedLeads")
  observations    Observation[]
  dailyReports    DailyReport[]
  blogPosts       BlogPost[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════

// ════════════════════════════════════════════════════════════════
// ════════════════════════════════════════════════════════════════

// Session model - secure HTTP-only cookie based sessions
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?  // Browser identification
  ipAddress    String?  // IP address at login
  lastActivity DateTime @default(now()) // Last activity timestamp
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// LoginLog model - audit trail for all login attempts
model LoginLog {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String    // Email used for login attempt
  success      Boolean   @default(false) // Whether login succeeded
  failureReason String?  // Reason for failure if applicable
  ipAddress    String?   // IP address
  userAgent    String?   // Browser/client info
  country      String?   // Country from IP
  city         String?   // City from IP
  createdAt    DateTime  @default(now())
}

// ═══════════════════════════════════════════════════════════════════
// QRTagsPro V3 — CustomAgencyType (métier générique personnalisable)
// ═══════════════════════════════════════════════════════════════════
// Permet au superadmin de créer un nouveau métier sans coder:
//   - Schéma de champs dynamique (JSON)
//   - Champ date de départ pour cron auto-checkout
//   - Message WhatsApp personnalisé
//   - Labels colonnes dashboard
model CustomAgencyType {
  id                String   @id @default(cuid())
  key               String   @unique        // ex: "spa", "gym", "entreprise"
  name              String                   // affichage (ex: "Spa & Thalasso")
  icon              String   @default("💼")  // emoji
  description       String?
  // JSON string: tableau de champs
  // [{ key, label, type, required, placeholder, options?, helper? }]
  // type: "text" | "tel" | "email" | "date" | "datetime-local" | "textarea" | "number" | "select"
  fieldsSchema      String
  // Clé du champ (dans fieldsSchema) à utiliser comme date de départ
  // pour le cron auto-checkout. Si null → pas d'auto-expiration
  departureFieldKey String?
  // Message WhatsApp personnalisé (optionnel). Variables: {reference}, {agencyName}, {finderName}, {finderPhone}, {location}
  finderMessage     String?
  // Labels personnalisés pour le dashboard (optionnel)
  colClientLabel    String?  // ex: "Client", "Adhérent", "Participant"
  colSubLabel       String?  // ex: "Dossier", "Badge", "Casier"
  agencies          Agency[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Agency model - QRTags multi-business agencies (hotel, school, luggage_locker, car_rental, medical, generic)
model Agency {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  email              String?
  phone              String?
  address            String?
  // QRTagsPro V1 — WhatsApp reception phone (used by finder scan → wa.me click-to-chat)
  contactPhone       String?
  // QRTagsPro V4 — Logo de l'agence (base64 data URL ou URL externe)
  // Affiché sur la page trouveur /scan/[reference]
  logoUrl            String?
  agencyType         String    @default("generic") // "hotel" | "airbnb" | "school" | "luggage_locker" | "car_rental" | "medical" | "custom" | "generic"
  customTypeId       String?   // Si agencyType = "custom", référence vers CustomAgencyType
  customType         CustomAgencyType? @relation(fields: [customTypeId], references: [id], onDelete: SetNull)
  // Module Bracelets Universel — profil de l'hôtel qui détermine le contenu
  // affiché sur /welcome/[slug]?context=WRISTBAND. Un seul produit, 4 expériences.
  // Valeurs: "BUSINESS" | "TRANSIT" | "RESORT" | "BOUTIQUE" | "HOST" | "STANDARD"
  braceletProfile    String?   @default("STANDARD")
  // Volet Touristique Géolocalisé — coordonnées GPS pour le calcul de distance (Haversine)
  latitude           Float?
  longitude          Float?
  // QRTagsPro V4 — PMS Integration (Property Management System)
  pmsProvider        String?   // "CLOUDBEDS" | "MEWS" | "SIRVOY" | null
  pmsApiKeys         String?   // JSON string: { apiKey, propertyId, baseUrl }
  pmsPropertyId      String?   // ID de l'hôtel dans le PMS
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  baggages           Baggage[]
  users              User[]
  invoices           Invoice[]
  braceletPackOrders BraceletPackOrder[]
  hotelPartners      HotelPartner[]
  partnerClicks      PartnerClick[]
  houseGuide         HouseGuide?
  hostReservations   HostReservation[]
  hostKitOrders      HostKitOrder[]
  hotelServices      HotelService[]
  serviceRequests    ServiceRequest[]
  serviceTemplates   ServiceTemplate[]
  teams              Team[]
  stays              Stay[]
  lostItems          LostItem[]
  personBracelets    PersonBracelet[]
}

// Baggage model (QRTags "Tag")
model Baggage {
  id                String    @id @default(cuid())
  reference         String    @unique
  type              String    @default("voyageur")
  setId             String?
  agencyId          String?
  travelerFirstName String?
  travelerLastName  String?
  whatsappOwner     String?
  baggageIndex      Int?      @default(1)
  baggageType       String?   @default("cabine")
  status            String    @default("in_stock")
  createdAt         DateTime  @default(now())
  expiresAt         DateTime?
  // QRTagsPro V1 — Hotel check-out date (used by cron job for auto-expire)
  departureDate     DateTime?
  lastScanDate      DateTime?
  lastLocation      String?
  declaredLostAt    DateTime?
  foundAt           DateTime?
  founderName       String?
  founderPhone      String?
  founderAt         DateTime?

  // ─── Suivi partageable (page /track/[token]) ───
  trackingToken     String?   @unique               // Token unique pour le lien de suivi propriétaire
  trackingEnabled   Boolean   @default(true)         // Le propriétaire peut désactiver le suivi
  scanCount         Int       @default(0)            // Nombre total de scans
  lastScanLocation  String?                          // Ville/pays du dernier scan
  isLost            Boolean   @default(false)        // Objet signalé perdu par le propriétaire
  lostReportedAt    DateTime?                        // Date du signalement de perte
  lostMessage       String?                          // Message personnalisé du propriétaire quand l'objet est perdu

  // ─── Données personnalisées (JSON) ───
  // Stocke les champs dynamiques du formulaire d'inscription :
  // { category, category_label, object_name, object_description, brand, model, color,
  //   city, country, reward, message_to_finder, email, photo, ... }
  customData        String?

  // ─── Module Bracelets All-Inclusive ───
  context              String?  @default("ROOM")
  braceletPackOrderId  String?
  braceletPackOrder    BraceletPackOrder? @relation(fields: [braceletPackOrderId], references: [id], onDelete: SetNull)

  agency            Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  scanLogs          ScanLog[]
  damageReports     DamageReport[]
  serviceRequests   ServiceRequest[]
  stays             Stay[]
  personBracelet    PersonBracelet?
}

// ScanLog model - tracks all scans for audit
model ScanLog {
  id          String   @id @default(cuid())
  baggageId   String
  ipAddress   String?
  country     String?
  city        String?
  latitude    Float?
  longitude   Float?
  location    String?  // Selected location (Jeddah, Médine, etc.)
  message     String?  // Optional message from finder
  createdAt   DateTime @default(now())
  baggage     Baggage  @relation(fields: [baggageId], references: [id], onDelete: Cascade)

  // ─── Champs IA (Groq) ───
  whatsappStatus  String?   // "sent" | "delivered" | "failed" | "fallback" | "queued" | "read"
  aiAnalysis      Json?     // ScanAIAnalysis: { type, color, size, confidence, isDuplicate, description?, analyzedAt }
  groqUsed        Boolean   @default(false) // true si Groq a été utilisé pour ce scan
  groqLatencyMs   Int?      // Temps de réponse Groq en ms
  aiMessageUsed   Boolean   @default(false) // true si le message WhatsApp a été généré par IA
  groqModelUsed   String?   // Modèle Groq utilisé (ex: "llama-3.3-70b-versatile")
  wakitMessageId  String?   // ID de retour Wakit pour tracking croisé

  // ─── Contexte du scan ───
  context     String?   // "departure_airport_urgent" | "arrival_airport" | "in_transit" | "static_location"
  finderName  String?   // Nom du trouveur (dupliqué ici pour l'API suivi)
  finderPhone String?   // Téléphone du trouveur (dupliqué ici pour l'API suivi)
}

// Settings model - system configuration
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Page model - CMS pages
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   // HTML or Markdown content
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Banner model - dashboard announcements
model Banner {
  id        String   @id @default(cuid())
  type      String   // "header" or "footer"
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// FeatureFlag model - modular feature toggles
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique // ex: "whatsapp_automated"
  label       String   // "Envoi WhatsApp automatisé"
  description String   // Clear description for admins
  category    String   @default("general") // "communication", "geolocation", "export", "notifications"
  enabled     Boolean  @default(false)
  icon        String?  // Icon name for UI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Message model - contact, partner requests, agency orders, assistance
// Message types:
// - "contact": Contact form from public website
// - "partenaire": Partner registration requests
// - "commande_agence": QR code orders from agencies
// - "assistance_agence": Support messages from agencies to superadmin
// - "reponse_assistance": Replies from superadmin to agencies
// - "message_superadmin": Messages initiated by superadmin for specific agencies
model Message {
  id          String   @id @default(cuid())
  type        String   // "contact", "partenaire", "commande_agence", "assistance_agence", "reponse_assistance", "message_superadmin"
  status      String   @default("non_lu") // "non_lu", "lu", "traite"
  senderName  String?
  senderEmail String?
  senderPhone String?
  agencyId    String?  // lien vers Agence (si commande agence ou assistance)
  recipientAgencyId String? // Pour les messages du superadmin vers une agence spécifique
  subject     String?  // Subject line for assistance messages
  content     String   // JSON ou texte brut
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Notification model - real-time alerts for SuperAdmin
// Notification types:
// - "baggage_declared_lost": Agency declared a baggage as lost
// - "baggage_found": Lost baggage was found
// - "new_assistance_message": New assistance message from agency
// - "urgent_scan": Urgent scan on lost baggage
model Notification {
  id          String   @id @default(cuid())
  type        String   // "baggage_declared_lost", "baggage_found", "new_assistance_message", "urgent_scan"
  userId      String?  // null = broadcast to all superadmins
  agencyId    String?  // Reference to agency if applicable
  baggageId   String?  // Reference to baggage if applicable
  message     String   // Notification message
  data        String?  // JSON additional data
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// EmailSettings model - SMTP configuration
model EmailSettings {
  id              String   @id @default(cuid())
  provider        String   @default("console") // "console" or "smtp"
  fromEmail       String   @default("noreply@qrbag.com")
  fromName        String   @default("QRBag")
  recipientEmail  String?  // Destination for admin notification emails
  // SMTP settings
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpPassword    String?
  smtpEncryption  String   @default("tls") // "tls", "ssl", "none"
  // Status
  isActive        Boolean  @default(true)
  lastTestAt      DateTime?
  lastTestStatus  String?  // "success", "failed"
  lastTestError   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// EmailLog model - tracks all sent emails
model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  type        String   // "verification", "password_reset", "notification", "invoice", "test", "welcome"
  status      String   @default("pending") // "pending", "sent", "failed"
  error       String?
  userId      String?
  agencyId    String?
  data        String?  // JSON for additional data
  sentAt      DateTime?
  createdAt   DateTime @default(now())
}

// EmailToken model - for email verification and password reset
model EmailToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  type      String   // "email_verification", "password_reset"
  code      String?  // 6-digit code for verification
  expiresAt DateTime
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// Invoice model - for agency billing
model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique
  agencyId      String
  agency        Agency   @relation(fields: [agencyId], references: [id])
  amount        Float
  currency      String   @default("EUR")
  status        String   @default("pending") // "pending", "paid", "cancelled"
  description   String?
  items         String   // JSON array of invoice items
  dueDate       DateTime?
  paidAt        DateTime?
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Lead model - CRM leads/prospects
model Lead {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  company       String?
  status        String        @default("new") // "new", "contacted", "in_discussion", "qualified", "converted", "lost"
  source        String?       // "website", "referral", "social", "event", "other"
  notes         String?
  agencyId      String?       // Link to agency if converted
  assignedToId  String?       // Agent assigned to this lead
  assignedTo    User?         @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  observations  Observation[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Observation model - tracks interactions with leads
model Observation {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   // "note", "rdv", "appel", "email", "whatsapp"
  content   String   // Observation content
  date      DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// DailyReport model - agent daily activity reports
model DailyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  content   String   // Free text report
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// Advertisement model - promotional banners for agencies
model Advertisement {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String   // URL to banner image
  linkUrl     String?  // Click destination URL
  linkTarget  String   @default("_blank") // "_blank" or "_self"
  
  // Position - only footer
  position    String   @default("footer") // "footer", "header", "sidebar"
  
  // Targeting
  targetScope String   @default("all") // "all", "agency", "agents"
  agencyId    String?  // Specific agency if targetScope = "agency"
  
  // Scheduling
  startDate   DateTime
  endDate     DateTime?
  
  // Status
  status      String   @default("draft") // "draft", "active", "paused", "expired"
  priority    Int      @default(0) // Higher = more prominent
  
  // Statistics
  impressions Int      @default(0)
  clicks      Int      @default(0)
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  adImpressions AdImpression[]
}

// AdImpression model - tracks each impression and click
model AdImpression {
  id              String   @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  
  // Viewer info
  userId          String?  // Logged-in user who viewed
  agencyId        String?  // Agency of the viewer
  userRole        String?  // Role of the viewer
  
  // Action
  action          String   // "impression" or "click"
  
  // Context
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime @default(now())
}

// BlogPost model - internal blog for agencies
model BlogPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  content       String   // HTML content from rich editor
  excerpt       String?  // Short summary
  coverImage    String?  // URL to cover image
  
  // Categorization
  category      String   @default("actualites") // "actualites", "conseils", "hajj", "mises_a_jour"
  
  // Publishing
  status        String   @default("draft") // "draft", "published"
  publishedAt   DateTime?
  
  // Author
  authorId      String?
  author        User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  
  // Metrics
  views         Int      @default(0)
  
  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  blogViews     BlogView[]
}

// BlogView model - track article views
model BlogView {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // Viewer info
  userId      String?
  agencyId    String?
  
  // Context
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
}

// SystemLog model - centralized system logging for monitoring
model SystemLog {
  id        String   @id @default(cuid())
  level     String   // "info" | "warn" | "error" | "fatal"
  message   String
  source    String   // ex: "api/activate", "diagnostic", "chatbot"
  metadata  String?  // JSON string with contextual data (sanitized)
  createdAt DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([createdAt])
}

// Checklist model - public travel inventory checklists generated by passengers
// Each checklist is identified by a 6-char public code (URL: /checklist/[code])
// and protected by an 8-char verification key required to view the PDF content.
model Checklist {
  id              String   @id @default(cuid())
  // Public 6-char code (base32, no I/O/0/1) — used in URL /checklist/[code]
  code            String   @unique
  // 8-char verification key required to view/download the PDF
  verificationKey String
  // Passenger info
  firstName       String
  lastName        String
  email           String
  departureDate   String   // ISO date string (yyyy-mm-dd) — kept as string for simplicity
  departureCity   String?  // ex: "Paris", "Dakar"
  destinationCountry String
  airline         String?
  flightNumber    String?  // ex: "AF123", "AT020"
  // Selected items (JSON array of {category, name, qty, checked})
  items           String   // JSON string
  itemsCount      Int      @default(0)
  // Photo upload
  photoPath       String?  // Path to uploaded suitcase photo on disk
  photoSizeBytes  Int?     @default(0)
  // PDF generation metadata
  pdfPath         String?  // Optional on-disk path; null = generate on-demand
  pdfSizeBytes    Int?     @default(0)
  // Tracking
  viewCount       Int      @default(0)
  lastViewedAt    DateTime?
  emailSent       Boolean  @default(false)
  emailSentAt     DateTime?
  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
  @@index([email])
  @@index([createdAt])
}

// QRTagsPro V4 — Demo interactive (bac à sable)
// Données supprimées automatiquement après 2 heures via cron
model DemoScan {
  id            String   @id @default(cuid())
  reference     String   @default("DEMO-TEST")
  finderName    String
  finderPhone   String
  location      String?
  mapsLink      String?
  message       String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime
}

// Review model - user reviews/testimonials for social proof
model Review {
  id          String   @id @default(cuid())
  name        String   // Reviewer name (public)
  location    String?  // City/country
  rating      Int      // 1-5 stars
  title       String?  // Short title
  content     String   // Review text
  baggageRef  String?  // Optional reference to the baggage
  isFeatured  Boolean  @default(false) // Show on landing page
  isApproved  Boolean  @default(false) // Admin must approve
  response    String?  // Admin reply
  language    String   @default("fr") // "fr" | "en" | "ar"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isApproved])
  @@index([isFeatured])
  @@index([createdAt])
}

// LossAlert model - proactive loss detection alerts
model LossAlert {
  id          String   @id @default(cuid())
  baggageId   String
  reference   String   // Denormalized for quick lookup
  alertType   String   @default("no_scan_after_arrival") // "no_scan_after_arrival" | "no_scan_duration"
  message     String
  dismissed   Boolean  @default(false)
  dismissedAt DateTime?
  createdAt   DateTime @default(now())
}

// ════════════════════════════════════════════════════════════════
// LABS — Feature D: Signalement de dommage
// Documentation de l'état du bagage avant/après voyage.
// Sert de preuve en cas de litige avec la compagnie aérienne.
// ════════════════════════════════════════════════════════════════

model DamageReport {
  id          String   @id @default(cuid())
  baggageId   String
  type        String   // "before" (pre-contrôle) | "after" (post-contrôle)
  photos      String   // JSON array of file paths: '["/uploads/damage/abc.jpg", ...]'
  description String?  // Description de l'état du bagage
  createdAt   DateTime @default(now())

  baggage     Baggage  @relation(fields: [baggageId], references: [id], onDelete: Cascade)

  @@index([baggageId])
  @@index([type])
}

// ════════════════════════════════════════════════════════════════
// MODULE BRACELETS ALL-INCLUSIVE
// Bracelets physiques portés au poignet par les clients d'hôtels resorts.
// ════════════════════════════════════════════════════════════════

model BraceletPackOrder {
  id                String    @id @default(cuid())
  agencyId          String?
  agency            Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  quantity          Int
  isBranded         Boolean   @default(false)
  unitPrice         Int
  totalPrice        Int
  status            String    @default("PENDING")
  maquetteStatus    String    @default("PENDING")
  maquetteUrl       String?
  maquetteValidatedAt DateTime?
  logoUrl           String?
  brandText         String?
  brandColors       String?
  customerName      String
  customerPhone     String
  customerEmail     String?
  deliveryCity      String?
  deliveryQuartier  String?
  deliveryAddress   String?
  paymentMethod     String?
  paymentStatus     String    @default("PENDING")
  paymentReference  String?
  trackingNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  activatedAt       DateTime?
  activatedCount    Int       @default(0)
  notes             String?
  adminNotes        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  baggages          Baggage[]
  @@index([agencyId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════
// VOLET TOURISTIQUE GÉOLOCALISÉ
// Partenaires recommandés par l'hôtel + tracking des clics
// ════════════════════════════════════════════════════════════════

model HotelPartner {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  category    String
  description String?
  latitude    Float
  longitude   Float
  rating      Float    @default(4.5)
  promoCode   String?
  commission  Int      @default(0)
  isVerified  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clicks      PartnerClick[]
  @@index([agencyId])
  @@index([category])
  @@index([isActive])
}

model PartnerClick {
  id         String   @id @default(cuid())
  partnerId  String
  agencyId   String
  clickedAt  DateTime @default(now())
  deviceType String?
  source     String?
  partner    HotelPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  agency     Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  @@index([partnerId])
  @@index([agencyId, clickedAt])
}

// ════════════════════════════════════════════════════════════════
// MODULE QRTAGS HOST — Conciergerie digitale Airbnb
// ════════════════════════════════════════════════════════════════

model HouseGuide {
