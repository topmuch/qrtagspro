  @@index([agencyId])
  @@index([status])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════
// MODULE HÔTEL 3 COUCHES — Services & Demandes
// Catalogue de services configurable par l'hôtel + file de demandes
// ════════════════════════════════════════════════════════════════

model HotelService {
  id              String   @id @default(cuid())
  agencyId        String
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  // ─── Identité ───
  name            String   // ex: "Serviettes supplémentaires"
  description     String?  // ex: "Demandez des serviettes supplémentaires"
  icon            String   @default("📋") // emoji

  // ─── Type & Catégorie ───
  // type: "request" (demande) | "order" (commande) | "booking" (réservation) | "info" (information)
  type            String   @default("request")
  // category: "housekeeping" (ménage) | "maintenance" | "food" (restauration) | "spa" | "reception" | "transport" | "other"
  category        String   @default("other")

  // ─── Configuration ───
  isActive        Boolean  @default(true)
  isFree          Boolean  @default(true)
  price           Int      @default(0) // FCFA si payant
  // JSON: horaires d'activité [{ day: "mon", open: "07:00", close: "21:00" }, ...]
  // Si null → 24/7
  schedule        String?
  // JSON: créneaux [{ time: "10:00", capacity: 8 }, ...] (pour réservations)
  slots           String?
  // JSON: menu items [{ name, price, photoUrl, available }, ...] (pour commandes)
  menu            String?

  // ─── Routage staff ───
  // Équipe destinataire: "housekeeping" | "maintenance" | "kitchen" | "spa" | "reception"
  assignedTeam    String   @default("reception")

  // ─── Onglet d'affichage ───
  // "hotel" (Mon Hôtel) | "tourism" (Autour de moi) | "help" (Aide)
  displayTab      String   @default("hotel")

  // ─── Module v2 : Mode d'emploi appareil ───
  // Si type = "info" et category = "guide", peut être lié à un ModèleAppareil
  modeleId         String?  // référence vers ModeleAppareil (autocomplétion)
  photoCustom      String?  // photo personnalisée (remplace photo du modèle)
  videoUrl         String?  // URL vidéo YouTube (surcharge du modèle)
  etapes           String?  // JSON i18n: étapes d'utilisation (surcharge)
  depannage        String?  // JSON i18n: dépannage (surcharge)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requests        ServiceRequest[]

  @@index([agencyId])
  @@index([category])
  @@index([isActive])
  @@index([displayTab])
  @@index([modeleId])
}

model ServiceRequest {
  id              String   @id @default(cuid())
  agencyId        String
  serviceId       String
  baggageId       String?  // bracelet du client (null si walk-in)

  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  service         HotelService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  baggage         Baggage? @relation(fields: [baggageId], references: [id], onDelete: SetNull)

  // ─── Infos client ───
  guestName       String?
  roomNumber      String?
  guestPhone      String?

  // ─── Détails de la demande ───
  // Pour les commandes: JSON [{ itemId, quantity, price }, ...]
  items           String?
  notes           String?  // Notes du client

  // ─── Statut ───
  // "new" (nouvelle) → "in_progress" (en cours) → "done" (traitée) → "cancelled"
  status          String   @default("new")
  handledBy       String?  // Nom du staff qui a traité
  handledAt       DateTime?

  // ─── Montant (si commande payante) ───
  totalAmount     Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agencyId])
  @@index([serviceId])
  @@index([status])
  @@index([createdAt])
}

// ════════════════════════════════════════════════════════════════
// MODULE HÔTEL PRO — Équipes, Templates, Séjours, Objets trouvés
// ════════════════════════════════════════════════════════════════

// Équipes staff (1 par catégorie de service, avec email de notification)
model Team {
  id              String   @id @default(cuid())
  agencyId        String
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  category        String   // "housekeeping" | "maintenance" | "food" | "spa" | "reception" | "bar" | "management"
  email           String   // email de notification pour cette équipe
  label           String?  // nom affiché (ex: "Équipe Ménage")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([agencyId, category])
  @@index([agencyId])
}

// Catalogue global de 30 services pré-remplis (templates)
model ServiceTemplate {
  id              String   @id @default(cuid())
  agencyId        String?  // null = template global, sinon = agence qui a personnalisé
  agency          Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  // Identité
  name            String   // ex: "Serviettes supplémentaires"
  nameEn          String?
  nameEs          String?
  description     String?
  descriptionEn   String?
  descriptionEs   String?
  icon            String   @default("📋")
  // Config par défaut
  type            String   @default("request") // "request" | "order" | "booking" | "info"
  category        String   @default("other")
  displayTab      String   @default("hotel")
  assignedTeam    String   @default("reception")
  isFree          Boolean  @default(true)
  defaultPrice    Int      @default(0)
  // Horaires par défaut (JSON simple: {days: "mon-sun", open: "07:00", close: "21:00"} ou "24/7")
  defaultSchedule String?
  // Pack d'appartenance (pour packs 1 clic: "urban", "resort", "bnb")
  pack            String?  // "urban" | "resort" | "bnb" | null
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  @@index([agencyId])
  @@index([category])
  @@index([pack])
}

// Séjour client (liaison bracelet ↔ chambre ↔ dates)
model Stay {
  id              String   @id @default(cuid())
  agencyId        String
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  baggageId       String?  // bracelet lié
  baggage         Baggage? @relation(fields: [baggageId], references: [id], onDelete: SetNull)
  // Infos séjour
  roomNumber      String?
  guestName       String?
  guestEmail      String?  // pour notifications
  guestPhone      String?
  language        String   @default("fr") // "fr" | "en" | "es"
  checkInDate     DateTime
  checkOutDate    DateTime
  nbPersons       Int      @default(1)
  status          String   @default("active") // "active" | "checked_out" | "cancelled"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([agencyId])
  @@index([baggageId])
  @@index([status])
}

// Objets trouvés (inventaire hôtel)
model LostItem {
  id              String   @id @default(cuid())
  agencyId        String
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  // Description
  name            String   // ex: "iPhone 15 noir"
  category        String   @default("other") // "electronics" | "clothing" | "documents" | "jewelry" | "other"
  description     String?
  photoUrl        String?
  // Lieu et date
  foundLocation   String?  // ex: "Chambre 204" | "Lobby" | "Piscine"
  foundDate       DateTime @default(now())
  foundBy         String?  // nom du staff
  // Restitution
  status          String   @default("found") // "found" → "claimed" → "returned" → "shipped" → "donated"
  claimedBy       String?  // nom du réclamant
  claimedDate     DateTime?
  returnedDate    DateTime?
  shippedTo       String?  // adresse d'expédition
  trackingNumber  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([agencyId])
  @@index([status])
  @@index([category])
}

// ════════════════════════════════════════════════════════════════
// MODULE v2 — RÉFÉRENTIEL APPAREILS (mode d'emploi pré-rempli)
// ════════════════════════════════════════════════════════════════
// Catalogue global de modèles d'appareils (Nespresso, Bosch, Samsung TV, etc.)
// utilisés par les services type "mode d'emploi" pour pré-remplir
// photo + vidéo YouTube + notice étapes + dépannage
model ModeleAppareil {
  id              String   @id @default(cuid())
  // Identité
  category        String   // "coffee" | "washing" | "tv" | "climate" | "jacuzzi" | "bbq" | "heating"
  brand           String   // ex: "Nespresso"
  model           String   // ex: "Essenza Mini"
  // Médias
  photoUrl        String?  // photo officielle (URL externe)
  videoUrl        String?  // URL YouTube (mode d'emploi)
  // Notices i18n (JSON: { fr: [...], en: [...], es: [...] })
  // etapes: [{ title, description }, ...] — étapes d'utilisation
  etapes          String?  // JSON i18n
  // depannage: [{ problem, solution }, ...] — problèmes courants + solutions
  depannage       String?  // JSON i18n
  // Recherche
  searchKey       String?  // "nespresso essenza mini" (lowercase, pour autocomplétion)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([category])
  @@index([brand])
  @@index([searchKey])
}

// ════════════════════════════════════════════════════════════════
// MODULE v2 — BRACELET PERSONNE (sécurité enfant/senior)
// ════════════════════════════════════════════════════════════════
// Bracelet QR porté par une personne (enfant, senior, personne vulnérable)
// Scan → page "Personne trouvée" → bouton appeler contact + partager position
model PersonBracelet {
  id              String   @id @default(cuid())
  agencyId        String?  // agence propriétaire (null si particulier)
  agency          Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  // Liaison au QR baggage
  baggageId       String?  @unique
  baggage         Baggage? @relation(fields: [baggageId], references: [id], onDelete: Cascade)
  // Profil de la personne
  personName      String   // ex: "Lucas Dupont"
  personType      String   @default("child") // "child" | "senior" | "medical" | "other"
  birthDate       DateTime?
  language        String   @default("fr") // langue préférée de la personne
  // Description physique (pour identification)
  description     String?  // ex: "Garçon, 6 ans, cheveux bruns, lunettes"
  photoUrl        String?  // photo de la personne
  // Infos médicales (optionnel)
  medicalInfo     String?  // ex: "Asthmatique - ventoline dans sac à dos"
  allergies       String?  // ex: "Arachide, pénicilline"
  bloodType       String?  // ex: "A+"
  // Contacts d'urgence (JSON: [{ name, phone, relation }])
  emergencyContacts String? // JSON
  // Statut
  status          String   @default("active") // "active" | "lost" | "found" | "returned"
  lastSeenAt      DateTime? // dernière fois vu
  lastSeenLocation String? // dernière position connue
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  positionAlerts  PositionAlert[]
  @@index([agencyId])
  @@index([status])
  @@index([personType])
}

// ════════════════════════════════════════════════════════════════
// MODULE v2 — ALERTES POSITION (partage GPS personne trouvée)
// ════════════════════════════════════════════════════════════════
model PositionAlert {
  id              String   @id @default(cuid())
  personBraceletId String
  personBracelet  PersonBracelet @relation(fields: [personBraceletId], references: [id], onDelete: Cascade)
  // Position partagée
  latitude        Float
  longitude       Float
  // Infos du trouveur
  finderName      String?  // nom optionnel
  finderPhone     String?  // téléphone optionnel
  finderMessage   String?  // message optionnel
  // Email envoyé aux contacts
  emailSent       Boolean  @default(false)
  emailRecipients String?  // liste des emails notifiés
  createdAt       DateTime @default(now())
  @@index([personBraceletId])
  @@index([createdAt])
}
